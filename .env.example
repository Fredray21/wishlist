# Copier ce fichier en `.env` (jamais commité) et remplir les valeurs.

# Mot de passe du mode admin (long et unique).
ADMIN_PASSWORD=change-me

# Secret de signature du cookie de session admin (>= 32 caractères aléatoires).
# Générer avec : openssl rand -hex 32
SESSION_SECRET=change-me-with-a-long-random-string

# Prénom affiché dans les titres et le bandeau anti-spoiler.
OWNER_NAME=Frédéric

# Mois d'anniversaire (1-12) pour le thème « Auto ». Laisser vide pour ne jamais
# basculer automatiquement sur le thème Anniversaire.
BIRTHDAY_MONTH=

# Optionnel : dossier des données (par défaut ./data).
# DATA_DIR=/app/data
